modules = ["python-base-3.13", "nodejs-24", "go-1.25", "dart-3.10", "java-graalvm22.3", "postgresql-16"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8008
externalPort = 8008

[[ports]]
localPort = 8080
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["gradle", "android-tools", "flutter"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ARMAN API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run build:web && cd backend && PORT=5000 go run ./cmd/api"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "ARMAN API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && PORT=8008 go run ./cmd/api"

[deployment]
run = ["sh", "-c", "cd backend && exec go run ./cmd/api"]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build:web"]
